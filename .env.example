# Invoice Processing System — environment configuration (placeholders only).
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must
# NEVER be committed. The application reads these at startup; see
# app/config.py. No default anywhere in the repo contains real key material.
#
# AI extraction (Z.ai GLM) — Sprint E2 consumes these; Sprint E0 stores them.
ZAI_API_KEY=your-api-key-here
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_TEXT_MODEL=glm-4.6
ZAI_VISION_MODEL=glm-4.5v
ZAI_TIMEOUT_SECONDS=60

# Flash-message signing (optional override; default is local-dev-only).
SECRET_KEY=local-dev-only
